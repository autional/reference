---
import RefLayout from '../layouts/RefLayout.astro';
import { t } from '../i18n';
import { SERVICES, GATEWAY_SHORT } from '../data/services';
import { API_HOST } from '../lib/site-env';
import { readSpec, specForService } from '../lib/specs';

export async function getStaticPaths() {
  return SERVICES.map((n) => ({ params: { service: n } }));
}

const { service } = Astro.params;

// 无公网 /bff 入口的六服务：顶栏尾段用 i18n 短标签，页内给出接入方式提示条
// （键 = service.accessLabel.<svc> / service.accessNote.<svc>，后者含 {apiHost} 占位）。
const NO_PUBLIC_ENTRY: readonly string[] = [
  'config-service', 'thirdparty-service', 'hash-service-standard',
  'hash-service-sm', 'stream-service', 'gateway-service',
];

const short = GATEWAY_SHORT[service];
const accessLabel = short
  ? `https://${API_HOST}/bff/${short}/api/v1/`
  : t(`service.accessLabel.${service}`);
const accessNote = NO_PUBLIC_ENTRY.includes(service)
  ? t(`service.accessNote.${service}`, { apiHost: API_HOST })
  : '';

// 规范按构建语言解析（en 缺源三服务回退 zh 原版 + 页内 fallbackNote 标注）。
const { file: specFile, fallback } = specForService(service);
const loaded = readSpec(specFile);

let specTitle = t('service.meta.titleFallback', { service });
let specDescription = t('service.meta.descriptionFallback', { service });
let endpointCount = 0;
if (loaded) {
  specTitle = `${loaded.spec.info?.title ?? service} — Autional`;
  specDescription = loaded.spec.info?.description || t('service.meta.descriptionGeneric', { service });
  endpointCount = loaded.endpoints;
}
---

<RefLayout title={specTitle} description={specDescription} keywords={t('service.meta.keywords', { service })}>
  <div id="scalar-wrapper" class="flex-1 flex flex-col min-h-0" style="overflow:hidden">
    <div class="px-4 py-2 border-b border-neutral-100 bg-white flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
      <span class="font-mono font-bold text-primary-600">{service}</span>
      <span class="text-neutral-300">|</span>
      <span class="whitespace-nowrap text-neutral-600">{endpointCount}<span data-i18n="service.endpointSuffix">{t('service.endpointSuffix')}</span></span>
      <span class="text-neutral-300">|</span>
      {short ? (
        <span class="break-all font-mono text-[11px] text-neutral-600" title={accessLabel}>{accessLabel}</span>
      ) : (
        <span class="text-neutral-600" data-i18n={`service.accessLabel.${service}`}>{accessLabel}</span>
      )}
    </div>
    {fallback && (
      <div class="border-b border-sky-100 bg-sky-50/70 px-4 py-2 text-xs leading-5 text-sky-900" data-i18n="service.fallbackNote">{t('service.fallbackNote')}</div>
    )}
    {accessNote && (
      <div class="border-b border-amber-100 bg-amber-50/70 px-4 py-2 text-xs leading-5 text-amber-900" data-i18n={`service.accessNote.${service}`}>{accessNote}</div>
    )}
    <div
      id="api-reference"
      data-url={`/specs/${specFile}`}
      data-theme="bluePlanet"
      data-layout="classic"
      data-show-side-bar="true"
      data-search-hotkey="k"
      style="min-height:0"
    >
    </div>
  </div>
  <script is:inline src="/scalar/1.59.2/api-reference.js"></script>
</RefLayout>

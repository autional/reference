---
import RefLayout from '../layouts/RefLayout.astro';
import { t } from '../i18n';
---

<RefLayout title={t('notFound.meta.title')} description={t('notFound.meta.description')}>
  <div class="flex-1 flex items-center justify-center p-8">
    <div class="text-center max-w-md">
      <p class="font-mono text-5xl font-extrabold text-primary-700" data-i18n="notFound.kicker">{t('notFound.kicker')}</p>
      <h1 class="mt-4 text-lg font-semibold text-neutral-900" data-i18n="notFound.title">{t('notFound.title')}</h1>
      <p class="mt-2 text-sm leading-6 text-neutral-600" data-i18n="notFound.lead">{t('notFound.lead')}</p>
      <a href="/" class="mt-6 inline-block brand-button-secondary px-5 py-2.5 text-xs" data-i18n="notFound.back">{t('notFound.back')}</a>
    </div>
  </div>
</RefLayout>

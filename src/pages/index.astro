---
import RefLayout from '../layouts/RefLayout.astro';
import { t } from '../i18n';
import { SERVICES, SERVICE_GROUPS } from '../data/services';
import { API_HOST, LOCALE } from '../lib/site-env';
import { readSpec, specForService } from '../lib/specs';

// 统计口径：按当前语言的 27 个服务逐一取规（en 缺源三服务回退 zh 原版）——
// 单次逐服务计数，不数目录文件（合并后目录内 51 个 json，数文件会双计）。
let totalEndpoints = 0;
for (const svc of SERVICES) {
  const loaded = readSpec(specForService(svc).file);
  if (loaded) totalEndpoints += loaded.endpoints;
}
const serviceCount = SERVICES.length;
const endpointLabel = totalEndpoints.toLocaleString(LOCALE);

const groups = SERVICE_GROUPS.map((g) => ({ key: g.key, name: t(`index.groups.${g.key}`), svcs: g.svcs }));
---

<RefLayout>
  <div class="flex-1 overflow-y-auto p-8">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-2xl font-extrabold tracking-tight text-neutral-900" data-i18n="index.title">{t('index.title')}</h1>
      <p class="mt-3 text-sm leading-6 text-neutral-600">
        <span data-i18n="index.leadA">{t('index.leadA')}</span>{serviceCount}<span data-i18n="index.leadB">{t('index.leadB')}</span><span class="font-mono text-[13px]">{API_HOST}</span><span data-i18n="index.leadBeforePath">{t('index.leadBeforePath')}</span><span class="font-mono text-[13px]" data-i18n="index.leadPath">{t('index.leadPath')}</span><span data-i18n="index.leadEnd">{t('index.leadEnd')}</span>
      </p>
      <p class="mt-3 text-xs text-neutral-600">
        <span class="font-semibold text-neutral-800">{serviceCount}</span><span data-i18n="index.statServices">{t('index.statServices')}</span> ·
        <span class="font-semibold text-neutral-800">{endpointLabel}</span><span data-i18n="index.statEndpoints">{t('index.statEndpoints')}</span> ·
        <span data-i18n="index.statDomains">{t('index.statDomains')}</span> · <span data-i18n="index.statSpec">{t('index.statSpec')}</span>
      </p>

      <div class="mt-8 grid grid-cols-1 gap-x-10 gap-y-6 sm:grid-cols-2">
        {groups.map(g => (
          <div>
            <div class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-primary-500" data-i18n={`index.groups.${g.key}`}>{g.name}</div>
            <div class="mt-2.5 flex flex-wrap gap-2">
              {g.svcs.map((name) => (
                <a href={`/${name}/`} class="inline-block rounded-lg border border-neutral-200 px-2.5 py-1.5 text-xs font-medium text-neutral-700 transition hover:border-primary-300 hover:bg-primary-50 hover:text-primary-700" data-i18n={`services.${name}`}>{t(`services.${name}`)}</a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <p class="mt-8 text-xs text-neutral-500 lg:hidden" data-i18n="index.hintMobile">{t('index.hintMobile')}</p>
      <p class="mt-8 hidden text-xs text-neutral-500 lg:block" data-i18n="index.hintDesktop">{t('index.hintDesktop')}</p>
    </div>
  </div>
</RefLayout>
